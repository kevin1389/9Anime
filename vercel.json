{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/home",
      "destination": "/api/index.js"
    },
    {
      "source": "/watch/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/episodes/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/stream/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/map/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/logo.svg",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
